# Copy to apps/site/.env.local (and set admin env separately under apps/admin/)

# Public site origin (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django API base (e.g. http://127.0.0.1:8000/api/v1)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Force mock/seed data even if API URL is set (true for offline UI work)
NEXT_PUBLIC_USE_SEED=true

# Server-only internal API for SSR (avoid public CDN hairpin)
API_INTERNAL_URL=

# Public media origin for /media/... rewriting
NEXT_PUBLIC_MEDIA_BASE_URL=
