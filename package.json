{
  "name": "drmojtahedi-front",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@drmojtahedi/site",
    "dev:site": "npm run dev --workspace=@drmojtahedi/site",
    "dev:admin": "npm run dev --workspace=@drmojtahedi/admin",
    "dev:all": "concurrently -n site,admin -c teal,magenta \"npm run dev:site\" \"npm run dev:admin\"",
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build --workspace=@drmojtahedi/site",
    "build:admin": "npm run build --workspace=@drmojtahedi/admin",
    "start": "npm run start --workspace=@drmojtahedi/site",
    "start:site": "npm run start --workspace=@drmojtahedi/site",
    "start:admin": "npm run start --workspace=@drmojtahedi/admin",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
